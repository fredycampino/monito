# Local builds by default. Published deployment: IMAGE_PREFIX=ghcr.io/fredycampino/
# and RELEASE_VERSION=<published version without v>; never latest.
IMAGE_PREFIX=
RELEASE_VERSION=dev

# Host user: id -u / id -g.
HOST_UID=1000
HOST_GID=1000

# Monito limits; no extra swap.
MONITO_MEMORY_LIMIT=8g
MONITO_CPU_LIMIT=8
MONITO_PIDS_LIMIT=256
MONITO_TMPFS_SIZE=128m

# Host paths per deployment; relative to the Compose project directory.
# Application JSON -> /etc/ggets/config.json (read-only).
GGETS_CONFIG_HOST_FILE=./data/ggets/config.json
# Variables loaded into the Ggets container.
GGETS_ENV_HOST_FILE=./docker/ggets.env
# Secrets -> /run/secrets (read-only, Ggets only).
GGETS_SECRETS_HOST_DIR=./data/ggets/secrets
# Persistent state -> /data/telegram (writable).
GGETS_STATE_HOST_DIR=./data/ggets/state

# Monito: writable home/workspace; read-only settings.
MONITO_HOME_HOST_DIR=./data/monito/home
MONITO_WORKSPACE_HOST_DIR=./data/monito/workspace
MONITO_SETTINGS_HOST_DIR=./data/monito/settings
# Runtime JSON -> /etc/monito/config.json (read-only).
MONITO_CONFIG_HOST_FILE=./data/monito/settings/config.json

# Separate API and Telegram networks; choose non-overlapping host ranges.
INTERNAL_SUBNET=172.28.0.0/24
INGRESS_SUBNET=172.29.0.0/24
# Match server.host and telegram.receiver_host in the Ggets JSON.
GGETS_INTERNAL_IP=172.28.0.2
GGETS_TELEGRAM_IP=172.29.0.2
# Host-only tunnel target; internal port must match telegram.receiver_port.
GGETS_TELEGRAM_BIND_IP=127.0.0.1
GGETS_TELEGRAM_HOST_PORT=8001
GGETS_TELEGRAM_PORT=8001
MONITO_INTERNAL_IP=172.28.0.3
