FROM node:22.23.4-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    adb openjdk-17-jre-headless python3 ca-certificates \
    && rm -rf /var/lib/apt/lists/*
ENV HOME=/data/home ANDROID_HOME=/usr/lib/android-sdk
WORKDIR /opt/mobile
COPY appium-lab/package.json appium-lab/package-lock.json ./
RUN npm ci --include=dev && npm cache clean --force \
    && rm -rf node_modules/.cache \
    && mkdir -p node_modules/.cache \
    && ln -s /tmp/mobile-cache node_modules/.cache/appium
COPY docker/mobile-entrypoint.py docker/mobile-healthcheck.py /usr/local/lib/mobile/
USER 10001:10001
ENTRYPOINT ["python3", "/usr/local/lib/mobile/mobile-entrypoint.py"]
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s \
    CMD ["python3", "/usr/local/lib/mobile/mobile-healthcheck.py"]
