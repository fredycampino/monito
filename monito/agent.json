{
  "llm": {
    "model": "gpt-5.6-terra",
    "provider": "codex"
  },
  "context": {
    "window_width_tokens": 100000,
    "compaction": {
      "compaction_trigger_ratio": 0.8,
      "compaction_target_ratio": 0.3,
      "keep_last_blocks": 10
    }
  },
  "loop": {
    "max_turns": 50,
    "max_tool_calls": 8
  },
  "debug": {
    "log_request": true,
    "log_override_file": true
  },
  "tools": {
    "shell": {
      "allowed_paths": [
        "~/develop/monito/",
        "~/.cloudflared/",
        "~/develop/py/skiller/"
      ],
      "allowlist_enabled": true,
      "allow_env_prefix": true,
      "allowed_commands": [
        "pwd",
        "ls",
        "find",
        "mv",
        "rg",
        "grep",
        "head",
        "tail",
        "wc",
        "nl",
        "cat",
        "git",
        "ruff",
        "pytest",
        "uv",
        "python",
        "python3",
        "skiller",
        "date",
        "find",
        "sed",
        "lms",
        "rm",
        "mkdir",
        "sh",
        "bash",
        "curl",
        "pkill",
        "aws",
        "gh",
        "cloudflare",
        "adb",
        "sk-telegram",
        "whoami",
        "docker",
        "id"
      ]
    },
    "files": {
      "read": [
        "~/develop/py/skiller/",
        "~/develop/monito/"
      ],
      "write": [
        ".",
        "~/develop/monito/"
      ],
      "all": []
    }
  }
}
